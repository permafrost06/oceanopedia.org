---
const pathname = Astro.url.pathname;
const navItems = [
  { href: "/contribute-to-oceanopedia/", label: "Contribute" },
  { href: "/about/", label: "About" },
];
---

<header class="bg-ocean text-foam">
  <div class="flex flex-wrap items-center justify-between gap-x-6 px-[30px] py-5 sm:flex-nowrap sm:px-[50px] sm:py-[21px]">
    <a href="/" class="flex w-full min-w-0 items-center gap-6 no-underline sm:w-auto" aria-label="Oceanopedia home">
      <img src="/uploads/2025/01/Mask-group.png" alt="" width="75" height="75" class="size-[75px] shrink-0" />
      <span class="min-w-0">
        <strong class="block text-[36px] leading-none tracking-tight sm:text-[48px]">Oceanopedia</strong>
        <span class="mt-2 block truncate text-sm leading-none text-sky-100">Your Guide to Oceanography</span>
      </span>
    </a>
    <nav aria-label="Primary navigation" class="mt-5 sm:mt-0">
      <ul class="flex items-center gap-6 text-sm sm:gap-5">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
              class:list={["border-b pb-1 transition-colors hover:border-sky-200", pathname === item.href ? "border-white" : "border-transparent"]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
