---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout>
  <section class="bg-water px-[30px] py-[50px] text-center text-foam sm:min-h-[548px] sm:px-8 sm:py-[88px]">
    <div class="mx-auto max-w-[650px]">
      <h1 class="text-[36px] font-normal leading-[1.12] tracking-tight sm:text-[48px]">We need writers for Oceanopedia</h1>
      <a href="/contribute-to-oceanopedia/" class="mt-8 inline-block rounded-full bg-foam px-9 py-3.5 text-base text-ocean transition hover:bg-white sm:text-lg">Contribute to Oceanopedia</a>
      <p class="mt-8 text-lg leading-8 sm:mt-7 sm:text-[22px]">Subscribe to our newsletter to be the first to get notified when we publish</p>
      <iframe
        src="https://embeds.beehiiv.com/69c0241f-eb90-47d8-8004-afdb2ba42460?slim=true"
        data-test-id="beehiiv-embed"
        title="Subscribe to the Oceanopedia newsletter"
        height="52"
        class="mx-auto mt-4 block w-full max-w-md border-0 bg-transparent"
      ></iframe>
    </div>
  </section>

  <section aria-labelledby="articles-heading" class="border-t-[70px] border-ocean">
    <h2 id="articles-heading" class="sr-only">Latest articles</h2>
    {articles.map((article) => (
      <article class="group relative isolate flex min-h-screen items-end overflow-hidden bg-ocean text-white">
        <img
          src={article.data.featuredImage}
          alt={article.data.featuredImageAlt}
          class="absolute inset-0 -z-20 size-full object-cover transition duration-700 group-hover:scale-[1.025]"
          loading={article === articles[0] ? "eager" : "lazy"}
        />
        <div class="absolute inset-0 -z-10 bg-black/50"></div>
        <div class="w-full px-[30px] py-12 sm:px-[50px] sm:py-16">
          <h3 class="max-w-5xl text-3xl font-normal leading-tight tracking-tight sm:text-5xl">
            <a href={`/${article.id}/`} class="after:absolute after:inset-0">{article.data.title}</a>
          </h3>
          <p class="mt-5 max-w-3xl text-base leading-relaxed text-sky-50 sm:text-lg">{article.data.description}</p>
          <span class="mt-6 inline-block border-b border-white pb-1 font-bold">Read more</span>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
