---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const latestArticles = articles.slice(0, 2);

// --- Article-preview showcase helpers ---
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
const topics = [
  "Marine Biology",
  "Oceanography",
  "Field Notes",
  "Ecology",
  "Conservation",
  "Deep Sea",
];
// Always yield exactly 5 articles, rotating the start so each section leads differently.
const pickFive = (offset: number) =>
  Array.from({ length: 5 }, (_, i) => articles[(i + offset) % articles.length]);

const navItems = [
  { href: "#articles", label: "Articles" },
  { href: "#articles", label: "Interviews" },
  { href: "#articles", label: "Tutorials" },
  { href: "/contribute-to-oceanopedia/", label: "Contribute" },
  { href: "/about/", label: "About" },
];
---

<BaseLayout showHeader={false}>
  <header
    data-home-header
    aria-hidden="true"
    inert
    class="pointer-events-none fixed inset-x-0 top-0 z-40 -translate-y-2 border-b border-[rgba(241,235,221,0.12)] bg-[rgba(30,66,86,0.62)] font-['Geist_Mono',ui-monospace,monospace] text-[#d8edf4] opacity-0 backdrop-blur-[14px] backdrop-saturate-[1.2] transition-[opacity,transform] duration-300 motion-reduce:translate-y-0 motion-reduce:transition-none"
  >
    <div class="flex h-16 items-center gap-3 px-4 sm:px-8">
      <a href="/" class="shrink-0 bg-[linear-gradient(135deg,rgba(211,241,247,0.85)_0%,transparent_38%),linear-gradient(25deg,transparent_24%,rgba(124,179,202,0.85)_52%,transparent_76%),linear-gradient(105deg,#9fcfdf_0%,#c5e8f0_28%,#acd9e6_54%,#d5f0f4_76%,#98cbdc_100%)] bg-[length:180%_180%,160%_160%,200%_200%] bg-clip-text bg-[position:0%_0%,100%_100%,0%_50%] font-['Big_Shoulders_Display',sans-serif] text-xl font-semibold uppercase tracking-[0.12em] text-transparent no-underline motion-safe:animate-[wordmark-gradient_12s_ease-in-out_infinite_alternate] sm:text-2xl sm:tracking-[0.16em]" aria-label="Oceanopedia home">Oceanopedia</a>
      <nav class="ml-auto hidden min-w-0 md:block" aria-label="Primary navigation">
        <div class="flex w-max items-center justify-end gap-0.5 text-[9px] uppercase tracking-[0.06em] sm:text-xs sm:tracking-[0.1em] md:text-sm md:tracking-[0.12em]">
          {navItems.map((item) => (
            <a class="rounded-[9px] border border-transparent px-1.5 py-2 transition duration-200 hover:border-[rgba(241,235,221,0.32)] hover:bg-[rgba(42,80,100,0.74)] sm:px-2.5" href={item.href}>{item.label}</a>
          ))}
        </div>
      </nav>
      <button
        data-menu-button
        type="button"
        class="ml-auto grid size-10 place-items-center rounded-[9px] border border-[rgba(241,235,221,0.2)] transition-colors hover:bg-[rgba(42,80,100,0.74)] md:hidden"
        aria-expanded="false"
        aria-controls="mobile-header-menu"
        aria-label="Open navigation menu"
      >
        <span class="flex w-5 flex-col gap-1.5" aria-hidden="true">
          <span class="h-px w-full bg-current"></span>
          <span class="h-px w-full bg-current"></span>
          <span class="h-px w-full bg-current"></span>
        </span>
      </button>
    </div>
    <nav id="mobile-header-menu" data-mobile-menu inert aria-hidden="true" class="pointer-events-none grid -translate-y-1 grid-rows-[0fr] border-t border-[rgba(241,235,221,0.12)] opacity-0 transition-[grid-template-rows,opacity,transform] duration-200 ease-out motion-reduce:translate-y-0 motion-reduce:transition-none md:hidden" aria-label="Mobile navigation">
      <div class="overflow-hidden">
        <div class="flex flex-col px-4 py-3 text-xs uppercase tracking-[0.12em]">
          {navItems.map((item) => (
            <a class="rounded-[9px] px-3 py-2.5 transition-colors hover:bg-[rgba(42,80,100,0.74)]" href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>
    </nav>
  </header>

  <section data-hero class="relative grid min-h-svh grid-rows-[auto_1fr_auto] gap-10 overflow-hidden bg-[linear-gradient(180deg,#08202e_0%,#051622_35%,#04111b_60%,#020a12_100%)] px-4 py-4 font-['Geist',ui-sans-serif,system-ui,sans-serif] text-[#d8edf4] sm:px-8 sm:pb-8 lg:grid-rows-1">
    <video
      class="absolute inset-0 size-full scale-x-[-1] object-cover opacity-70 [filter:saturate(1.5)_contrast(1.1)_brightness(0.5)_hue-rotate(30deg)]"
      src="/herobg_short.mp4"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      aria-hidden="true"
    ></video>
    <div class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(120%_70%_at_50%_-10%,rgba(123,194,217,0.1)_0%,transparent_45%),radial-gradient(80%_60%_at_50%_120%,rgba(10,40,60,0.55)_0%,transparent_60%),linear-gradient(90deg,rgba(2,10,18,0.16),transparent_52%,rgba(2,10,18,0.12))]"></div>

    <nav class="z-[2] flex flex-wrap items-center justify-center gap-0.5 justify-self-stretch rounded-[14px] border border-[rgba(241,235,221,0.12)] bg-[rgba(30,66,86,0.62)] p-2.5 font-['Geist_Mono',ui-monospace,monospace] text-[11px] uppercase tracking-[0.08em] backdrop-blur-[14px] backdrop-saturate-[1.2] md:justify-self-end md:text-sm md:tracking-[0.12em] lg:col-start-1 lg:row-start-1 lg:self-start" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a class="rounded-[9px] border border-transparent px-1.5 py-2 transition duration-200 hover:-translate-y-0.5 hover:border-[rgba(241,235,221,0.32)] hover:bg-[rgba(42,80,100,0.74)] sm:px-2.5" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="z-[2] self-center justify-self-start md:ml-[clamp(0rem,3.5vw,3rem)] lg:col-start-1 lg:row-start-1">
      <h1 class="bg-[linear-gradient(135deg,rgba(211,241,247,0.85)_0%,transparent_38%),linear-gradient(25deg,transparent_24%,rgba(124,179,202,0.85)_52%,transparent_76%),linear-gradient(105deg,#9fcfdf_0%,#c5e8f0_28%,#acd9e6_54%,#d5f0f4_76%,#98cbdc_100%)] bg-[length:180%_180%,160%_160%,200%_200%] bg-clip-text bg-[position:0%_0%,100%_100%,0%_50%] font-['Big_Shoulders_Display',sans-serif] text-[18vw] leading-[0.88] tracking-[-0.01em] text-transparent uppercase [font-weight:revert] motion-safe:animate-[wordmark-gradient_12s_ease-in-out_infinite_alternate] sm:text-[clamp(4.5rem,11.3vw,11.25rem)] sm:tracking-[clamp(0.1rem,0.75vw,0.75rem)] md:whitespace-nowrap">Oceanopedia</h1>
      <p class="mt-5 font-['Instrument_Serif',serif] text-[clamp(1.4rem,2vw,2rem)] italic leading-[1.3]">Your guide to Oceanography</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="group rounded-full bg-[#d8edf4] px-7 py-[14px] text-[13px] font-medium uppercase tracking-[0.04em] text-[#04111b] shadow-[0_8px_24px_rgba(0,0,0,0.35)] transition-colors hover:bg-white" href="/contribute-to-oceanopedia/">Contribute <span class="ml-2 inline-block transition-transform group-hover:translate-x-[3px]" aria-hidden="true">→</span></a>
        <a class="rounded-full border border-[rgba(241,235,221,0.45)] px-7 py-[14px] text-[13px] font-medium uppercase tracking-[0.04em] transition-colors hover:border-[#d8edf4] hover:bg-[rgba(241,235,221,0.06)]" href="/about/">Our mission</a>
      </div>
    </div>

    <div class="z-[2] flex w-full max-w-[440px] flex-col gap-3.5 justify-self-end lg:col-start-1 lg:row-start-1 lg:self-end">
      {latestArticles.map((article) => (
        <a class="group flex min-h-[104px] items-center gap-3 rounded-[14px] border border-[rgba(241,235,221,0.12)] bg-[rgba(30,66,86,0.62)] p-3 text-[#d8edf4] backdrop-blur-[14px] backdrop-saturate-[1.2] transition duration-200 hover:-translate-y-0.5 hover:border-[rgba(241,235,221,0.32)] hover:bg-[rgba(42,80,100,0.82)] sm:min-h-[124px] sm:gap-4 sm:p-4" href={`/${article.id}/`}>
          <img class="size-[76px] flex-none self-stretch rounded-[10px] object-cover sm:size-[90px]" src={article.data.featuredImage} alt={article.data.featuredImageAlt} width="90" height="90" />
          <span class="flex min-w-0 flex-1 flex-col">
            <span class="font-['Geist_Mono',ui-monospace,monospace] text-[10px] uppercase tracking-[0.2em] text-[rgba(216,237,244,0.45)] sm:text-[11px]">Latest article</span>
            <span class="mt-1.5 font-['Instrument_Serif',serif] text-[17px] italic leading-[1.15] tracking-[0.025em] text-[#d7edf2] sm:text-xl">{article.data.title}</span>
            <span class="ml-auto text-[29px] leading-[0.8] text-[rgba(216,237,244,0.62)] transition-transform group-hover:translate-x-[3px]" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
      <a class="group flex items-center justify-between gap-4 rounded-[14px] border border-[rgba(241,235,221,0.22)] bg-[rgba(4,17,27,0.68)] py-3 pl-[18px] pr-3 font-['Geist_Mono',ui-monospace,monospace] text-[11px] font-medium uppercase tracking-[0.11em] backdrop-blur-[14px] backdrop-saturate-[1.2] transition duration-200 hover:-translate-y-0.5 hover:border-[rgba(241,235,221,0.5)] hover:bg-[rgba(30,66,86,0.88)] sm:text-[13px]" href="#articles">
        Scroll down to see more articles
        <span class="grid size-[34px] flex-none place-items-center rounded-full bg-[#d8edf4] text-[17px] leading-none text-[#04111b] transition-transform group-hover:translate-y-[3px]" aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <div
    id="articles"
    class="bg-[linear-gradient(180deg,#020a12_0%,#04111b_45%,#051622_72%,#020a12_100%)] font-['Geist',ui-sans-serif,system-ui,sans-serif] text-[#d8edf4]"
  >
    <h2 class="sr-only">Article preview design variations</h2>

    {/* ============ Variation 01 — Editorial Index ============ */}
    <section class="border-t border-[rgba(241,235,221,0.08)] px-4 py-20 sm:px-8 sm:py-28">
      <div class="mx-auto max-w-[1200px]">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-4 sm:mb-14">
          <div>
            <span class="font-['Geist_Mono',ui-monospace,monospace] text-[11px] uppercase tracking-[0.3em] text-[rgba(216,237,244,0.45)]">Variation 01</span>
            <h3 class="mt-3 font-['Big_Shoulders_Display',sans-serif] text-4xl uppercase leading-[0.9] tracking-[0.02em] sm:text-6xl">Editorial Index</h3>
          </div>
          <p class="max-w-xs font-['Instrument_Serif',serif] text-lg italic leading-snug text-[rgba(216,237,244,0.65)]">Numbered magazine-style rows with a thumbnail that reveals on hover.</p>
        </div>

        <ol class="border-t border-[rgba(241,235,221,0.1)]">
          {pickFive(0).map((article, i) => (
            <li>
              <a href={`/${article.id}/`} class="group grid grid-cols-[auto_1fr_auto] items-center gap-4 border-b border-[rgba(241,235,221,0.1)] px-1 py-6 transition-colors duration-300 hover:bg-[rgba(30,66,86,0.4)] sm:gap-8 sm:px-4 sm:py-8">
                <span class="font-['Big_Shoulders_Display',sans-serif] text-3xl leading-none text-[rgba(216,237,244,0.28)] transition-colors duration-300 group-hover:text-[#9fcfdf] sm:text-5xl">{String(i + 1).padStart(2, "0")}</span>
                <span class="min-w-0">
                  <span class="block truncate font-['Instrument_Serif',serif] text-xl italic leading-tight tracking-[0.02em] sm:text-3xl">{article.data.title}</span>
                  <span class="mt-2 block font-['Geist_Mono',ui-monospace,monospace] text-[10px] uppercase tracking-[0.2em] text-[rgba(216,237,244,0.45)] sm:text-[11px]">{topics[i % topics.length]} — {fmtDate(article.data.publishedAt)}</span>
                </span>
                <span class="flex items-center gap-3 sm:gap-5">
                  <img src={article.data.featuredImage} alt="" width="64" height="64" class="hidden size-14 rounded-[10px] object-cover opacity-0 transition-opacity duration-300 group-hover:opacity-100 sm:block sm:size-16" />
                  <span class="text-2xl leading-none text-[rgba(216,237,244,0.5)] transition-transform duration-300 group-hover:translate-x-1 group-hover:text-[#d8edf4]" aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ============ Variation 02 — Bento Feature ============ */}
    <section class="border-t border-[rgba(241,235,221,0.08)] px-4 py-20 sm:px-8 sm:py-28">
      <div class="mx-auto max-w-[1200px]">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-4 sm:mb-14">
          <div>
            <span class="font-['Geist_Mono',ui-monospace,monospace] text-[11px] uppercase tracking-[0.3em] text-[rgba(216,237,244,0.45)]">Variation 02</span>
            <h3 class="mt-3 font-['Big_Shoulders_Display',sans-serif] text-4xl uppercase leading-[0.9] tracking-[0.02em] sm:text-6xl">Bento Feature</h3>
          </div>
          <p class="max-w-xs font-['Instrument_Serif',serif] text-lg italic leading-snug text-[rgba(216,237,244,0.65)]">An asymmetric grid leading with one large hero and four glass tiles.</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {pickFive(1).map((article, i) =>
            i === 0 ? (
              <a href={`/${article.id}/`} class="group relative isolate flex min-h-[320px] flex-col justify-end overflow-hidden rounded-[14px] border border-[rgba(241,235,221,0.12)] p-6 transition duration-300 hover:border-[rgba(241,235,221,0.32)] sm:col-span-2 sm:min-h-[380px] lg:row-span-2 lg:min-h-full">
                <img src={article.data.featuredImage} alt={article.data.featuredImageAlt} class="absolute inset-0 -z-20 size-full object-cover transition duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(2,10,18,0.1)_25%,rgba(2,10,18,0.55)_60%,rgba(2,10,18,0.9)_100%)]"></div>
                <span class="font-['Geist_Mono',ui-monospace,monospace] text-[11px] uppercase tracking-[0.2em] text-[#9fcfdf]">Featured — {topics[i % topics.length]}</span>
                <h4 class="mt-3 max-w-xl font-['Instrument_Serif',serif] text-3xl italic leading-[1.1] sm:text-4xl">{article.data.title}</h4>
                <p class="mt-3 line-clamp-2 max-w-lg text-sm leading-relaxed text-[rgba(216,237,244,0.78)]">{article.data.description}</p>
              </a>
            ) : (
              <a href={`/${article.id}/`} class="group flex flex-col gap-3 rounded-[14px] border border-[rgba(241,235,221,0.12)] bg-[rgba(30,66,86,0.62)] p-4 backdrop-blur-[14px] backdrop-saturate-[1.2] transition duration-200 hover:-translate-y-0.5 hover:border-[rgba(241,235,221,0.32)] hover:bg-[rgba(42,80,100,0.82)]">
                <span class="font-['Geist_Mono',ui-monospace,monospace] text-[10px] uppercase tracking-[0.2em] text-[rgba(216,237,244,0.45)]">{topics[i % topics.length]}</span>
                <span class="line-clamp-3 font-['Instrument_Serif',serif] text-lg italic leading-tight sm:text-xl">{article.data.title}</span>
                <span class="mt-auto font-['Geist_Mono',ui-monospace,monospace] text-[10px] uppercase tracking-[0.2em] text-[rgba(216,237,244,0.4)]">{fmtDate(article.data.publishedAt)}</span>
              </a>
            ),
          )}
        </div>
      </div>
    </section>

    {/* ============ Variation 03 — Glass Card Grid ============ */}
    <section class="border-t border-[rgba(241,235,221,0.08)] px-4 py-20 sm:px-8 sm:py-28">
      <div class="mx-auto max-w-[1200px]">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-4 sm:mb-14">
          <div>
            <span class="font-['Geist_Mono',ui-monospace,monospace] text-[11px] uppercase tracking-[0.3em] text-[rgba(216,237,244,0.45)]">Variation 03</span>
            <h3 class="mt-3 font-['Big_Shoulders_Display',sans-serif] text-4xl uppercase leading-[0.9] tracking-[0.02em] sm:text-6xl">Glass Card Grid</h3>
          </div>
          <p class="max-w-xs font-['Instrument_Serif',serif] text-lg italic leading-snug text-[rgba(216,237,244,0.65)]">Uniform frosted cards — image, category, title and a short excerpt.</p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
          {pickFive(2).map((article, i) => (
            <a href={`/${article.id}/`} class="group flex flex-col overflow-hidden rounded-[14px] border border-[rgba(241,235,221,0.12)] bg-[rgba(30,66,86,0.62)] backdrop-blur-[14px] backdrop-saturate-[1.2] transition duration-200 hover:-translate-y-1 hover:border-[rgba(241,235,221,0.32)] hover:bg-[rgba(42,80,100,0.82)]">
              <div class="aspect-[4/3] overflow-hidden">
                <img src={article.data.featuredImage} alt={article.data.featuredImageAlt} class="size-full object-cover transition duration-700 group-hover:scale-105" />
              </div>
              <div class="flex flex-1 flex-col gap-2 p-4">
                <span class="font-['Geist_Mono',ui-monospace,monospace] text-[10px] uppercase tracking-[0.2em] text-[rgba(216,237,244,0.45)]">{topics[i % topics.length]}</span>
                <span class="line-clamp-2 font-['Instrument_Serif',serif] text-lg italic leading-tight">{article.data.title}</span>
                <p class="line-clamp-3 text-[13px] leading-relaxed text-[rgba(216,237,244,0.62)]">{article.data.description}</p>
                <span class="mt-auto flex items-center gap-2 pt-2 font-['Geist_Mono',ui-monospace,monospace] text-[10px] uppercase tracking-[0.2em] text-[rgba(216,237,244,0.55)] transition-colors group-hover:text-[#9fcfdf]">Read <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* ============ Variation 04 — Cinematic Posters ============ */}
    <section class="border-t border-[rgba(241,235,221,0.08)] px-4 py-20 sm:px-8 sm:py-28">
      <div class="mx-auto max-w-[1200px]">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-4 sm:mb-14">
          <div>
            <span class="font-['Geist_Mono',ui-monospace,monospace] text-[11px] uppercase tracking-[0.3em] text-[rgba(216,237,244,0.45)]">Variation 04</span>
            <h3 class="mt-3 font-['Big_Shoulders_Display',sans-serif] text-4xl uppercase leading-[0.9] tracking-[0.02em] sm:text-6xl">Cinematic Posters</h3>
          </div>
          <p class="max-w-xs font-['Instrument_Serif',serif] text-lg italic leading-snug text-[rgba(216,237,244,0.65)]">Tall portrait tiles with full-bleed imagery and gradient overlays.</p>
        </div>

        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
          {pickFive(3).map((article, i) => (
            <a href={`/${article.id}/`} class="group relative isolate flex aspect-[3/4] flex-col justify-end overflow-hidden rounded-[14px] border border-[rgba(241,235,221,0.12)] p-4 transition duration-300 hover:-translate-y-1 hover:border-[rgba(241,235,221,0.4)]">
              <img src={article.data.featuredImage} alt={article.data.featuredImageAlt} class="absolute inset-0 -z-20 size-full object-cover transition duration-700 group-hover:scale-105" />
              <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(2,10,18,0.05)_35%,rgba(2,10,18,0.55)_68%,rgba(2,10,18,0.92)_100%)]"></div>
              <span class="font-['Geist_Mono',ui-monospace,monospace] text-[9px] uppercase tracking-[0.2em] text-[#9fcfdf] sm:text-[10px]">{topics[i % topics.length]}</span>
              <h4 class="mt-2 line-clamp-3 font-['Instrument_Serif',serif] text-lg italic leading-tight sm:text-xl">{article.data.title}</h4>
              <span class="mt-2 flex items-center gap-1.5 font-['Geist_Mono',ui-monospace,monospace] text-[9px] uppercase tracking-[0.2em] text-[rgba(216,237,244,0.6)] opacity-0 transition-opacity duration-300 group-hover:opacity-100">Read <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* ============ Variation 05 — Minimal Typographic ============ */}
    <section class="border-t border-[rgba(241,235,221,0.08)] px-4 py-20 sm:px-8 sm:py-28">
      <div class="mx-auto max-w-[1200px]">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-4 sm:mb-14">
          <div>
            <span class="font-['Geist_Mono',ui-monospace,monospace] text-[11px] uppercase tracking-[0.3em] text-[rgba(216,237,244,0.45)]">Variation 05</span>
            <h3 class="mt-3 font-['Big_Shoulders_Display',sans-serif] text-4xl uppercase leading-[0.9] tracking-[0.02em] sm:text-6xl">Minimal Typographic</h3>
          </div>
          <p class="max-w-xs font-['Instrument_Serif',serif] text-lg italic leading-snug text-[rgba(216,237,244,0.65)]">Image-free, centred and airy — the titles carry the whole design.</p>
        </div>

        <div class="mx-auto max-w-3xl border-t border-[rgba(241,235,221,0.1)]">
          {pickFive(4).map((article, i) => (
            <a href={`/${article.id}/`} class="group flex flex-col items-center gap-3 border-b border-[rgba(241,235,221,0.1)] py-8 text-center transition-colors duration-300 hover:bg-[rgba(30,66,86,0.28)] sm:py-10">
              <span class="inline-flex items-center gap-2 rounded-full border border-[rgba(241,235,221,0.2)] px-3 py-1 font-['Geist_Mono',ui-monospace,monospace] text-[10px] uppercase tracking-[0.2em] text-[rgba(216,237,244,0.55)] transition-colors group-hover:border-[rgba(241,235,221,0.4)] group-hover:text-[#9fcfdf]">{topics[i % topics.length]}</span>
              <h4 class="max-w-2xl font-['Instrument_Serif',serif] text-3xl italic leading-[1.1] tracking-[0.01em] transition-colors group-hover:text-white sm:text-5xl">{article.data.title}</h4>
              <span class="font-['Geist_Mono',ui-monospace,monospace] text-[10px] uppercase tracking-[0.2em] text-[rgba(216,237,244,0.4)] sm:text-[11px]">{fmtDate(article.data.publishedAt)} · {article.data.authors[0]}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const hero = document.querySelector("[data-hero]");
  const header = document.querySelector("[data-home-header]");

  if (hero instanceof HTMLElement && header instanceof HTMLElement) {
    const menuButton = header.querySelector("[data-menu-button]");
    const mobileMenu = header.querySelector("[data-mobile-menu]");

    const setMenuVisibility = (visible: boolean) => {
      if (!(menuButton instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) return;
      menuButton.setAttribute("aria-expanded", String(visible));
      menuButton.setAttribute("aria-label", visible ? "Close navigation menu" : "Open navigation menu");
      mobileMenu.classList.toggle("pointer-events-none", !visible);
      mobileMenu.classList.toggle("-translate-y-1", !visible);
      mobileMenu.classList.toggle("grid-rows-[0fr]", !visible);
      mobileMenu.classList.toggle("opacity-0", !visible);
      mobileMenu.classList.toggle("grid-rows-[1fr]", visible);
      mobileMenu.classList.toggle("translate-y-0", visible);
      mobileMenu.classList.toggle("opacity-100", visible);
      mobileMenu.toggleAttribute("inert", !visible);
      mobileMenu.setAttribute("aria-hidden", String(!visible));
    };

    const setHeaderVisibility = (visible: boolean) => {
      header.classList.toggle("pointer-events-none", !visible);
      header.classList.toggle("-translate-y-2", !visible);
      header.classList.toggle("opacity-0", !visible);
      header.toggleAttribute("inert", !visible);
      header.setAttribute("aria-hidden", String(!visible));
      if (!visible) setMenuVisibility(false);
    };

    if (menuButton instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement) {
      menuButton.addEventListener("click", () => {
        setMenuVisibility(menuButton.getAttribute("aria-expanded") !== "true");
      });
      mobileMenu.addEventListener("click", (event) => {
        if (event.target instanceof HTMLAnchorElement) setMenuVisibility(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenuVisibility(false);
      });
    }

    const observer = new IntersectionObserver(([entry]) => {
      setHeaderVisibility(!entry.isIntersecting && entry.boundingClientRect.bottom <= 0);
    });

    observer.observe(hero);
  }
</script>

