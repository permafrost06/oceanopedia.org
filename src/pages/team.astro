---
import BaseLayout from "../layouts/BaseLayout.astro";

const team = [
  {
    name: "Zahin Azmayeen",
    image: "/uploads/team/zahin-azmayeen.jpg",
    imagePosition: "center",
    bio: "Zahin is a software engineer and a co-founder of Oceanopedia. Since he wasn't a regular student, he'd realize how amazing and interesting Oceanography is only during pre-exam cramming sessions with Fakhrul Alam Anik. It was one such day before an exam when, alongside Anik, he came up with the idea of a community-driven Oceanography resource - this is the genesis of Oceanopedia. Zahin now writes and edits articles for Oceanopedia and maintains the website.",
    links: [
      { label: "Website", href: "https://permafrost06.com" },
      { label: "GitHub", href: "https://github.com/permafrost06" },
      { label: "LinkedIn", href: "https://www.linkedin.com/in/zahin-azmayeen/" },
    ],
  },
  {
    name: "Md Fakhrul Alam Anik",
    image: "/uploads/team/fakhrul-alam-anik.jpg",
    imagePosition: "center",
    bio: "While studying for his honours degree in Oceanography at Shahjalal University of Science and Technology, Sylhet, Bangladesh, Fakhrul came up with the idea for Oceanopedia alongside his friend and FIFA rival, Zahin. Fakhrul is currently pursuing his master’s degree at IBA, University of Dhaka, Bangladesh.",
    links: [
      { label: "Facebook", href: "https://www.facebook.com/akaki.anik.35" },
      { label: "LinkedIn", href: "https://www.linkedin.com/in/md-fakhrul-alam-anik " },
    ],
  },
  {
    name: "Md. Omar Meharab",
    image: "/uploads/team/omar-meharab.png",
    imagePosition: "center",
    bio: "Md. Omar Meharab is an ocean enthusiast. He did not choose the ocean; rather, the ocean chose him. Although he is professionally an English teacher, the ocean still calls him. He stays connected to that part of his heart through Oceanopedia.",
    links: [
      { label: "LinkedIn", href: "https://www.linkedin.com/in/omarmeharab" },
    ],
  },
  {
    name: "Md Abu Yousuf Prodhan",
    image: "/uploads/team/abu-yousuf-prodhan.jpg",
    imagePosition: "55% center",
    bio: "Md Abu Yousuf Prodhan is an early-career oceanographer fascinated by the hidden dynamics of the ocean and the stories they tell. Whether exploring marine processes through data and modelling or translating complex science into engaging narratives, he believes knowledge creates the greatest impact when it reaches the people who need it most. His work bridges physical oceanography, predictive modelling, science communication, and community engagement, driven by a vision of making ocean science more accessible, meaningful, and relevant to society.",
    links: [
      { label: "LinkedIn", href: "https://www.linkedin.com/in/md-abu-yousuf-prodhan-7373951b9/" },
      { label: "GitHub", href: "https://github.com/SiAm1998" },
    ],
  },
  {
    name: "Nadim Rahman",
    image: "/uploads/team/nadim-rahman.jpg",
    imagePosition: "center",
    bio: "Md Nadim Rahman is a Research Associate at GREENS with expertise in GIS, machine learning, and remote sensing. He holds a B.Sc. (Honors) in Oceanography from Shahjalal University of Science and Technology. He specializes in ocean-climate modeling and marine environmental dynamics, applying computational and data-driven approaches to address pressing global climate challenges. His work bridges physical oceanography with modern geospatial and machine learning technologies, with a strong preference for open-source tools, workflow automation, and reproducible science.",
    links: [
      { label: "GitHub", href: "https://github.com/nadim-ocg" },
      { label: "LinkedIn", href: "https://www.linkedin.com/in/nadim-ocg" },
    ],
  },
  {
    name: "Samiha Subha Sooha",
    image: "/uploads/team/samiha-subha-sooha.jpg",
    imagePosition: "center",
    bio: "Samiha Subha Sooha is an undergraduate Oceanography student in her final year at Shahjalal University of Science and Technology, Sylhet. Her interests include Climate Change, GIS, Remote Sensing, Chemical Oceanography, and Deep-Sea Ecosystems. She is passionate about oceanographic research to better understand marine and coastal environments, particularly addressing climate-related challenges.",
    links: [
      { label: "Facebook", href: "https://www.facebook.com/share/1AnUQVExGQ/" },
    ],
  },
];
---

<BaseLayout
  title="Team"
  description="Meet the people who write, research, and build Oceanopedia, a community-driven oceanography resource."
  headerVariant="cinematic"
  footerVariant="cinematic"
>
  <section class="team-hero relative isolate overflow-hidden border-b border-[rgba(241,235,221,0.08)] bg-[linear-gradient(135deg,#061a27_0%,#04111b_62%,#020a12_100%)] px-4 py-20 font-['Geist',ui-sans-serif,system-ui,sans-serif] sm:px-8 sm:py-28">
    <div class="relative z-10 mx-auto max-w-[1180px]">
      <p class="font-['Geist_Mono',ui-monospace,monospace] text-[10px] uppercase tracking-[0.24em] text-[#9fcfdf] sm:text-xs">The Oceanopedia team</p>
      <div class="mt-5 grid gap-8 lg:grid-cols-[1.35fr_0.65fr] lg:items-end lg:gap-20">
        <h1 class="max-w-4xl font-['Instrument_Serif',serif] text-[44px] font-normal italic leading-[1.02] tracking-[-0.035em] text-[#d7edf2] sm:text-[68px] lg:text-[82px]">
            Meet the people behind Oceanopedia
        </h1>
      </div>
    </div>
  </section>

  <section aria-labelledby="people-heading" class="bg-[linear-gradient(180deg,#04111b_0%,#020a12_100%)] px-4 py-16 font-['Geist',ui-sans-serif,system-ui,sans-serif] sm:px-8 sm:py-24">
    <div class="mx-auto max-w-[1180px]">

      <ol class="divide-y divide-[rgba(241,235,221,0.12)]">
        {team.map((member, index) => (
          <li class:list={[
            "grid gap-8 py-12 sm:py-16 md:gap-14 lg:gap-24",
            index % 2 === 1
              ? "md:grid-cols-[minmax(0,1.2fr)_minmax(260px,0.8fr)]"
              : "md:grid-cols-[minmax(260px,0.8fr)_minmax(0,1.2fr)]",
            ]}>
              <div class:list={["relative", index % 2 === 1 && "md:order-2"]}>
              <div class="aspect-[4/5] overflow-hidden rounded-[14px] border border-[rgba(241,235,221,0.12)] bg-[#061a27]">
                <img
                  src={member.image}
                  alt={`Portrait of ${member.name}`}
                  width="720"
                  height="900"
                  class="size-full object-cover transition duration-500 hover:scale-[1.02]"
                  style={`object-position: ${member.imagePosition}`}
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </div>
            </div>

            <div class="flex flex-col justify-center md:py-5">
              <h3 class="font-['Instrument_Serif',serif] text-[32px] font-normal italic leading-tight tracking-tight text-[#d7edf2] sm:text-[42px]">{member.name}</h3>
              <div class="mt-5 h-px w-12 bg-[#9fcfdf]/60"></div>
              <p class="mt-6 max-w-2xl text-base leading-[1.8] text-[rgba(216,237,244,0.68)] sm:text-lg">{member.bio}</p>
              <ul aria-label={`${member.name}'s links`} class="mt-8 flex flex-wrap gap-x-7 gap-y-3">
                {member.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noreferrer"
                      class="group inline-flex items-center gap-2 border-b border-[rgba(159,207,223,0.4)] pb-1 font-['Geist_Mono',ui-monospace,monospace] text-[10px] font-medium uppercase tracking-[0.14em] text-[#d8edf4] transition-colors hover:border-[#d8edf4]"
                    >
                      {link.label}
                      <span aria-hidden="true" class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .team-hero::after {
    background:
      radial-gradient(circle at center, transparent 0 25%, rgb(159 207 223 / 8%) 25.2% 25.7%, transparent 25.9% 40%, rgb(159 207 223 / 6%) 40.2% 40.6%, transparent 40.8% 55%, rgb(159 207 223 / 5%) 55.2% 55.5%, transparent 55.7%);
    content: "";
    height: 48rem;
    pointer-events: none;
    position: absolute;
    right: -18rem;
    top: -22rem;
    width: 48rem;
  }
</style>
