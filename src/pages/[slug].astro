---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={article.data.featuredImage}
  type="article"
  headerVariant="cinematic"
  footerVariant="cinematic"
>
  <article class="bg-[linear-gradient(180deg,#061a27_0%,#04111b_38%,#020a12_100%)] font-['Geist',ui-sans-serif,system-ui,sans-serif] text-[#d8edf4]">
    <header class="mx-auto max-w-[960px] px-4 pb-10 pt-16 sm:px-8 sm:pb-14 sm:pt-24">
      <h1 class="max-w-[900px] font-['Instrument_Serif',serif] text-[clamp(2.75rem,7vw,6.25rem)] font-normal italic leading-[0.98] tracking-[-0.035em] text-[#d7edf2]">{article.data.title}</h1>
      <p class="mt-8 font-['Geist_Mono',ui-monospace,monospace] text-[10px] uppercase tracking-[0.16em] text-[rgba(216,237,244,0.55)] sm:text-xs">
        Written by {article.data.authors.join(" and ")}
      </p>
    </header>
    <figure class="mx-4 aspect-[3/2] max-h-[760px] overflow-hidden rounded-[14px] border border-[rgba(241,235,221,0.12)] sm:mx-8 xl:mx-auto xl:max-w-[1320px]">
      <img src={article.data.featuredImage} alt={article.data.featuredImageAlt} class="size-full object-cover" />
    </figure>
    <div class="article-body cinematic-article mx-auto max-w-[760px] px-4 pb-24 pt-10 sm:px-8 sm:pb-32 sm:pt-16">
      <Content />
    </div>
  </article>
</BaseLayout>
